{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixelbolt authored poses",
  "type": "object",
  "properties": {
    "format": {
      "const": "pixelforge-poses"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "palette": {
      "type": "object",
      "maxProperties": 257,
      "properties": {
        "$ref": {
          "type": "string",
          "description": "Shared palette file, resolved by the CLI and MCP relative to this recipe. Local entries add to or override it."
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(transparent|#([a-fA-F0-9]{3,4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8}))$"
      }
    },
    "ramps": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "maxItems": 32,
        "minItems": 2
      },
      "maxItems": 64,
      "description": "Palette keys from dark to light, one list per material. shade and scene ramp lighting move a colour along its ramp instead of inventing one. A key belongs to one ramp. A shared palette file ({\"palette\": {...}, \"ramps\": [...]}) can supply them."
    },
    "light": {
      "type": "integer",
      "minimum": 0,
      "maximum": 359,
      "description": "Clockwise light direction: 0 right, 225 top left (default)."
    },
    "parts": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
        "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "rows": {
                "$ref": "#/$defs/rows"
              },
              "anchor": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -4096,
                  "maximum": 4096
                },
                "maxItems": 2,
                "minItems": 2,
                "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
              },
              "points": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -4096,
                    "maximum": 4096
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
                }
              },
              "views": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 16,
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]?|[12][0-9]{2}|3[0-5][0-9])$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "rows": {
                      "$ref": "#/$defs/rows"
                    },
                    "anchor": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -4096,
                        "maximum": 4096
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
                    },
                    "points": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                        "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                      },
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": -4096,
                          "maximum": 4096
                        },
                        "maxItems": 2,
                        "minItems": 2,
                        "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
                      }
                    }
                  },
                  "required": [
                    "rows",
                    "anchor"
                  ],
                  "additionalProperties": false
                },
                "description": "Authored grid drawings by world angle (0–359). Each supplies its anchor and every named point of the base part. Use the nearest drawing within 22.5 degrees; otherwise rotate the base grid."
              }
            },
            "required": [
              "rows"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "bone": {
                "type": "object",
                "properties": {
                  "ramp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63,
                    "description": "Index of a source ramp; structural parts use one-character palette keys."
                  },
                  "base": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31,
                    "description": "Neutral fill step inside that ramp."
                  },
                  "outline": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1
                      },
                      {
                        "const": "selective"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "One-pixel outer line: a palette key, selective for the darkest ramp step, or null/omitted for none."
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64,
                    "description": "Start-to-end joint distance in pixels."
                  },
                  "width": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16
                    },
                    "maxItems": 3,
                    "minItems": 2,
                    "description": "[start, end] or [start, middle, end] fill widths."
                  },
                  "caps": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "round",
                        "flat",
                        "point",
                        "socket"
                      ]
                    },
                    "maxItems": 2,
                    "minItems": 2
                  },
                  "snap": {
                    "type": "boolean",
                    "description": "Snap within 4 degrees of a clean slope (default true); endpoints follow the stepped slope."
                  }
                },
                "required": [
                  "length",
                  "width",
                  "ramp",
                  "base"
                ],
                "additionalProperties": false
              },
              "points": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -64,
                        "maximum": 64
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "description": "[along, across] relative to the part anchor; transformed with the part."
                    },
                    {
                      "const": "end"
                    }
                  ]
                }
              }
            },
            "required": [
              "bone"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "mass": {
                "type": "object",
                "properties": {
                  "ramp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63,
                    "description": "Index of a source ramp; structural parts use one-character palette keys."
                  },
                  "base": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31,
                    "description": "Neutral fill step inside that ramp."
                  },
                  "outline": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1
                      },
                      {
                        "const": "selective"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "One-pixel outer line: a palette key, selective for the darkest ramp step, or null/omitted for none."
                  },
                  "size": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 64
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "description": "Unsquashed ellipse diameters [width, height]."
                  }
                },
                "required": [
                  "size",
                  "ramp",
                  "base"
                ],
                "additionalProperties": false
              },
              "points": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -64,
                    "maximum": 64
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "description": "[along, across] relative to the part anchor; transformed with the part."
                }
              }
            },
            "required": [
              "mass"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "poses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "origin": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -4096,
              "maximum": 4096
            },
            "maxItems": 2,
            "minItems": 2,
            "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
          },
          "mirror": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "description": "Reflect an earlier pose (parts, points and markers) around its origin corner: pixel column c becomes 2 × originX − 1 − c, as drawFrame's flipX does. Omit parts, markers and origin."
          },
          "relight": {
            "type": "boolean",
            "description": "Mirror poses only: redraw structural parts with the source light unchanged; false/omitted preserves exact runtime-flipped pixels."
          },
          "tween": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
              },
              "to": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
              },
              "t": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Position between the two poses."
              },
              "ease": {
                "enum": [
                  "linear",
                  "hold",
                  "in",
                  "out",
                  "inOut",
                  "overshoot",
                  "bounce"
                ],
                "description": "linear (default), hold (jump at the end), in, out, inOut, overshoot or bounce."
              }
            },
            "required": [
              "from",
              "to",
              "t"
            ],
            "additionalProperties": false,
            "description": "An in-between of two earlier authored or tweened poses with the same part instances: origin, offsets and angles interpolate and round; part definitions and flips switch at the eased halfway point. Omit parts and origin; markers are not inherited."
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "part": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "at": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -4096,
                    "maximum": 4096
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "description": "[x, y] in unscaled canvas pixels; the top-left corner of that pixel."
                },
                "attach": {
                  "type": "object",
                  "properties": {
                    "part": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                      "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                    },
                    "point": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                      "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                    }
                  },
                  "required": [
                    "part",
                    "point"
                  ],
                  "additionalProperties": false
                },
                "flipX": {
                  "type": "boolean",
                  "description": "Mirror this part, its anchor and its points inside the part."
                },
                "rotate": {
                  "type": "integer",
                  "minimum": -360,
                  "maximum": 360,
                  "description": "Whole degrees clockwise around the part anchor pixel, after any flip. The rotated grid is baked into an editable symbol named <part>-r<degrees> (-fr when flipped); points turn with it; right angles are exact."
                },
                "angle": {
                  "type": "integer",
                  "minimum": -360,
                  "maximum": 360,
                  "description": "Clockwise degrees relative to the parent world angle, or world degrees at a root. Mutually exclusive with rotate. Relative-angle tweens take the shorter arc."
                },
                "reach": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": -4096,
                    "maximum": 4096
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "description": "Canvas target [x, y] for the last bone of a two-bone chain. Replaces angle/rotate; attach to a named end point with zero at offset. Both bones are solved at whole degrees."
                },
                "bend": {
                  "enum": [
                    "forward",
                    "back"
                  ],
                  "description": "Reach only: preferred clockwise (forward, default) or anticlockwise bend. Equal-error solutions prefer this bend, then rest-angle proximity and lower angles."
                },
                "squash": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 2,
                  "description": "Mass parts only, in steps of 0.05. Height scales by squash and width by its inverse; contour adjustments keep opaque pixel area stable.",
                  "multipleOf": 0.05
                },
                "cleanup": {
                  "type": "boolean",
                  "description": "Remove doubled corners the rotation leaves (default true; false names the symbol with -raw)."
                }
              },
              "required": [
                "name",
                "part"
              ],
              "additionalProperties": false
            },
            "maxItems": 64
          },
          "markers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "part": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                },
                "point": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                  "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
                }
              },
              "required": [
                "name",
                "part",
                "point"
              ],
              "additionalProperties": false
            },
            "maxItems": 64
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "parts"
            ]
          },
          {
            "required": [
              "mirror"
            ]
          },
          {
            "required": [
              "tween"
            ]
          }
        ]
      },
      "maxItems": 256,
      "minItems": 1
    },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 65527,
      "description": "ZIP32 bundle budget: animation count + frame count + 7 support files must not exceed 65,535.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
        "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "frames": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "description": "Portable name: do not use Windows device names (CON, PRN, AUX, NUL, COM1–9, LPT1–9). Frame/animation names must be unique ignoring case."
            },
            "maxItems": 1024,
            "minItems": 1
          },
          "direction": {
            "enum": [
              "forward",
              "reverse",
              "pingpong"
            ]
          },
          "loop": {
            "type": "boolean"
          }
        },
        "required": [
          "frames"
        ],
        "additionalProperties": false
      }
    },
    "sheet": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "trim": {
          "type": "boolean",
          "description": "Pack each frame by its visible bounds; the atlas reports trimmed rectangles with spriteSourceSize. Ignores columns."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "width",
    "height",
    "parts",
    "poses"
  ],
  "additionalProperties": false,
  "$defs": {
    "rows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 256,
      "minItems": 1,
      "description": "Equal-width text rows. Every character is a palette key; dot and space skip a pixel."
    }
  }
}
