{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pixelbolt": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/pixelbolt.js",
        "mcp",
        "--root",
        "${PLUGIN_DATA}",
        "--out",
        "${PLUGIN_DATA}/output"
      ]
    }
  }
}
