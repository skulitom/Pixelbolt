; The Pixelbolt for Godot demo. Open this folder in Godot 4.5 or newer (the demo's recipe is a .pixel.json file;
; Godot 4.3 and 4.4 import only .pixelbolt files). The addon in addons/pixelbolt renders demo/hero.pixel.json with
; this checkout's own CLI (pixelbolt/cli/path below, relative to this folder), so Node.js 20 or newer must be on PATH.

config_version=5

[application]

config/name="Pixelbolt for Godot demo"
run/main_scene="res://demo/demo.tscn"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/pixelbolt/plugin.cfg")

[pixelbolt]

cli/path="../bin/pixelbolt.js"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
